# Oracle to consume (Phase 2 service)
ORACLE_URL=http://localhost:3001
ORACLE_WALLET_ADDRESS=0xe2F7a0E6d9865C7Dc9B5D19DCc11CBcb4655c661   # oracle's registered wallet

# Consumer agent identity
CONSUMER_PRIVATE_KEY=0x...
CONSUMER_WALLET_ADDRESS=0x...

# Circle Agent Wallet — USDC custody / balance-check only (Phase 7.2, post-submission
# — see CHANGELOG.md). Separate from CONSUMER_PRIVATE_KEY above: this wallet does NOT
# sign postBond/slash/fileIndictment/resolveDispute — those stay on CONSUMER_PRIVATE_KEY
# (or the session guard, if SESSION_GUARD_ADDRESS is set) exactly as before. Provisioned
# via `circle wallet login` + `circle wallet create` (@circle-fin/cli) — owned by a
# DIFFERENT Circle account than the oracle's Agent Wallet (see oracle/.env.example);
# switch `circle wallet login` sessions between the two when checking both from one CLI.
CONSUMER_AGENT_WALLET_ADDRESS=0xb84cd0e18a75dd89e6f7e2781012748f612d13c3

# Bond contract (from arcid2 deploy)
BOND_CONTRACT_ADDRESS=0x...
ARC_RPC_URL=http://127.0.0.1:8545   # local Hardhat node; set to Arc testnet RPC for prod

# Session-key wallet hardening (Phase 6, post-submission — see CHANGELOG.md).
# Optional. When set, CONSUMER_PRIVATE_KEY above is treated as a bounded
# session key (capped amount, fixed payout, time-limited) instead of holding
# unbounded slash/settlement authority directly. Deploy with
# `npm run deploy:session-guard:arc` + `npm run session:grant`; leave unset
# to keep the pre-Phase-6 behavior (CONSUMER_PRIVATE_KEY calls ArcIDBond
# directly as authorizedSlasher).
SESSION_GUARD_ADDRESS=

# Deterministic payment gate (Phase 7, post-submission — see CHANGELOG.md).
# PRICE_USDC must match oracle/.env's own PRICE_USDC exactly — settlement.js
# refuses any Gateway payment or on-chain record whose amount/payee diverges
# from these, independent of and in addition to any SESSION_GUARD_ADDRESS cap.
PRICE_USDC=0.001
MAX_SETTLEMENT_USDC=0.01

# Spend-velocity circuit breaker (Phase 8, post-submission — see CHANGELOG.md).
# Rolling per-minute/per-hour spend caps, computed from the settlement
# ledger (consumer/logs/settlement_ledger.json). Crossing either halts every
# further settlement call until a manual `npm run breaker:resume` — no
# auto-recovery. Tune down for a live demo where you want to show a trip.
MAX_SPEND_PER_MINUTE_USDC=0.05
MAX_SPEND_PER_HOUR_USDC=1.0

# Attributable audit trail (Phase 9, post-submission — see CHANGELOG.md).
# Optional. Set to ArcIDRegistryV2's address to have every
# consumer/logs/settlement_audit.jsonl record include the oracle wallet's
# real on-chain agentId (bytes32), not just its address. Leave unset to
# still get the audit trail, just without that field populated.
REGISTRY_ADDRESS=

# ERC-8004 reputation dual-write (Phase 8.2, post-submission — see
# CHANGELOG.md). Optional. Oracle's real agentId in Arc's real ERC-8004
# IdentityRegistry (0x8004A818BFB912233c491871b3d84c89A494BD9e on Arc
# Testnet) — register via `npm run bond:register-identity -- --role oracle`.
# Unset: erc8004.js skips the off-chain giveFeedback() write entirely.
ORACLE_AGENT_ID_8004=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
MODEL=claude-sonnet-4-6

# Loop
POLL_INTERVAL_MS=12000   # 12 seconds

# DEV_MODE: skip real on-chain slash + accept dev x402 payments + simulate settlement
DEV_MODE=true
