# Ingestion enclave identity — must be TEE-registered in ArcIDRegistry.
INGESTOR_PRIVATE_KEY=0x...
INGESTOR_WALLET_ADDRESS=0x...

PORT=3002

ARC_RPC_URL=https://rpc.testnet.arc.network
ARTIST_REGISTRY_ADDRESS=
TRAINING_POOL_ADDRESS=

# Phala Cloud TDX attestation — same split as oracle/.env.example.
# USE_REAL_PHALA=true only works inside a real Phala TDX CVM with the
# dstack guest-agent socket volume-mounted (see docker-compose.phala.yml).
USE_REAL_PHALA=false
