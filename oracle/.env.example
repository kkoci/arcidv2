# Oracle agent identity
# This wallet must be TEE-registered in ArcIDRegistry on Arc testnet.
# The private key signs every response — a wrong answer is attributable to this wallet.
ORACLE_PRIVATE_KEY=0x...
ORACLE_WALLET_ADDRESS=0x...

# Circle Agent Wallet — USDC custody / balance-check only (Phase 7.2, post-submission
# — see CHANGELOG.md). Separate from ORACLE_WALLET_ADDRESS above: this wallet does NOT
# sign postBond/slash/fileIndictment/resolveDispute or any oracle response — those stay
# on ORACLE_PRIVATE_KEY exactly as before. Provisioned via `circle wallet login` +
# `circle wallet create` (@circle-fin/cli), owned by the Circle account that ran that
# login, NOT necessarily the same email as whoever deployed the contracts.
ORACLE_AGENT_WALLET_ADDRESS=0x9867a0a4b7631a66b0433034a45e472023f809d6

# x402 payment config
PRICE_USDC=0.001
ARC_NETWORK=arc-testnet
FACILITATOR_URL=https://x402.org/facilitator

# Circle Gateway Nanopayments — wraps /api/price whenever DEV_MODE=false.
# Network is Arc Testnet's CAIP-2 id (chain 5042002 — verified via eth_chainId against
# ARC_RPC_URL; this is Circle's own "Arc Testnet" network, distinct from Arbitrum Sepolia's 421614).
GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com
GATEWAY_NETWORK=eip155:5042002
GATEWAY_DOMAIN=26
# Seller wallet that receives Gateway payments. Defaults to ORACLE_WALLET_ADDRESS if unset.
GATEWAY_SELLER_ADDRESS=

# Service SLA — consumer agent enforces this
MAX_AGE_SECONDS=30

# DEV_MODE=true → skip real payment verification (any X-Payment header accepted).
# Set to false on Arc testnet.
DEV_MODE=true

# Port
PORT=3000

# Fault-mode protection in production (any secret string)
# Required on /admin/fault, /admin/fault/reset, and /admin/trigger-cycle whenever DEV_MODE=false.
FAULT_TOKEN=change-me-in-production

# On-chain trigger-cycle + chain-stats config
ARC_RPC_URL=https://rpc.testnet.arc.network
BOND_CONTRACT_ADDRESS=
REGISTRY_ADDRESS=
DEPLOY_BLOCK=0
# eth_getLogs block-range-per-call cap (provider-dependent — Alchemy free
# tier caps this at 10). Raise this if the RPC plan is upgraded. Chain-stats
# scanning is incremental (see chain.js), so this mostly only matters for
# the one-time cold-start scan after an oracle restart, not routine polling.
ARC_LOG_CHUNK_SIZE=10
# Delay (ms) between successive successful chunk calls during a multi-chunk
# log scan — prevents tripping the provider's requests-per-second cap even
# when each individual call would otherwise succeed.
ARC_LOG_CALL_DELAY_MS=200
CONSUMER_PRIVATE_KEY=0x...
CONSUMER_WALLET_ADDRESS=0x...
# ANTHROPIC_API_KEY / MODEL removed (tiered-adjudication Phase 5 — see
# CHANGELOG.md): /admin/trigger-cycle's bad-sig fault is now a Tier 1
# deterministic verdict — no LLM call at all, so the old "keep this off
# Opus, an exposed endpoint gets expensive fast" cost concern for THIS
# specific endpoint no longer applies (still applies to the real consumer
# agent's own Tier 2 adjudication, which is unaffected by this change).

# Phase 5 — USYC yield-bearing bond (set after deploy_usyc.js)
USYC_BOND_ADDRESS=
USDC_BOND_ADDRESS=
USYC_TOKEN_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A

# Phala Cloud TDX attestation (Phase 7 — Phala CVM deployment)
# USE_REAL_PHALA=true  → GET /api/attest connects to the dstack guest agent's Unix socket via
#                         @phala/dstack-sdk. Only works inside a Phala TDX CVM with that socket
#                         volume-mounted (see oracle/docker-compose.phala.yml) — not over TCP/HTTP.
# USE_REAL_PHALA=false → /api/attest returns a structurally-valid prototype quote (local dev default).
USE_REAL_PHALA=false
