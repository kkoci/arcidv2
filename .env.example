# Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
# eth_getLogs block-range-per-call cap — provider-dependent (Alchemy free
# tier caps this at 10). Read by scripts/cli/list-agents.js; raise if the
# RPC plan is upgraded. Same var name oracle/.env's chain.js reads.
ARC_LOG_CHUNK_SIZE=10

# Your deployer wallet private key.
# Used for both on-chain transactions AND DCAP quote signing in deploy_standalone.js.
DEPLOYER_PRIVATE_KEY=0x...

# Arc testnet USDC (real address — do not change)
USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000

# DCAPVerifier on Arc testnet — do not change.
# Verifies Intel TDX DCAP v4 quote structure + ecrecover on report_data sig.
DCAP_VERIFIER_ADDRESS=0xBB2835fC4d189340a98084A50DD0B36b4Ff50Ca2

# Arc testnet USYC (Phase 5)
# USYC_TOKEN_ADDRESS=0xe9185F0c5F296Ed1797AaE4238D26CCaBEadb86C
# USYC_TELLER_ADDRESS=0x9fdF14c5B14173D74C08Af27AebFf39240dC105A

# Anthropic — consumer agent LLM adjudication (Phase 3)
ANTHROPIC_API_KEY=sk-ant-...

# One-off admin CLI scripts (scripts/cli/*.js) — post-submission (see
# CHANGELOG.md). Private keys for these are read ONLY from these env vars,
# never accepted as a CLI argument (CLAUDE.md's private-key rule — added
# after an incident where a --key flag got echoed into a visible transcript
# twice, once by npm's own command-echo and once by a raw error message).
# Each var matches the actual on-chain permission role the script needs:
AGENT_PRIVATE_KEY=0x...       # register.js, post-bond.js, gating-check.js — the wallet acting as an agent
SLASHER_PRIVATE_KEY=0x...     # slash.js, settle.js — must equal ArcIDBond.authorizedSlasher
GUARD_OWNER_PRIVATE_KEY=0x... # session-key.js — must equal ConsumerSessionKeyGuard.owner()
# DEPLOYER_PRIVATE_KEY (above) also doubles as the key for set-authorized-slasher.js — it's ArcIDBond's Ownable owner.
